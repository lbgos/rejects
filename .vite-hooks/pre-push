#!/bin/sh
# Blocks a push whose tree or new commits match a private denylist kept outside the repo
# (one extended regex per line). Opt in per clone, worktrees included:
#   git config rejects.leakDenylist /path/to/leak-denylist.txt
# Without that setting the hook does nothing. CI runs the same check in .github/workflows/leak-gate.yml.
list=$(git config --get rejects.leakDenylist || true)
[ -n "$list" ] || exit 0
[ -r "$list" ] || { echo "pre-push: cannot read rejects.leakDenylist" >&2; exit 1; }

scan="$(git rev-parse --show-toplevel)/.github/scripts/leak-scan.sh"
remote=$1
status=0
while read -r _local_ref local_sha _remote_ref remote_sha; do
  # A deletion pushes no content.
  case $local_sha in *[!0]*) ;; *) continue ;; esac
  case $remote_sha in
    *[!0]*) if git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
      sh "$scan" denylist "$list" "$local_sha" "$remote_sha..$local_sha" || status=1
      continue
    fi ;;
  esac
  sh "$scan" denylist "$list" "$local_sha" "$local_sha" --not --remotes="$remote" || status=1
done

[ $status -eq 0 ] || echo "pre-push: leak check failed, push blocked" >&2
exit $status
